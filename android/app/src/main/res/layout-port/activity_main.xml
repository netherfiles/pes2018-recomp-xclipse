<?xml version="1.0" encoding="utf-8"?>
<!-- Portrait variant (same ids): the wordmark and the build line in a header,
     the entries as one scrolling column with the chosen entry's details under
     them, the source credit pinned above the strip that the build line scrolls
     in. No hero picture here: the column is the screen. The landscape original
     is layout/activity_main.xml. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pes_page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- The wordmark, the build line, and a hairline closing the header. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitStart"
                    android:src="@drawable/launcher_logo"
                    android:contentDescription="@string/wordmark" />

                <TextView
                    android:id="@+id/version_tag"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textColor="@color/pes_muted"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif"
                    tools:text="0.0.2-alpha · build 16 · EUROPE" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:background="@color/pes_line" />
        </LinearLayout>

        <!-- menu_scroll: MainActivity scrolls this to the detail panel after a
             tap on an entry, so the chosen entry's own panel follows it. -->
        <ScrollView
            android:id="@+id/menu_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="10dp">

                <Button
                    android:id="@+id/play"
                    style="@style/MenuEntryRow"
                    android:text="@string/play"
                    android:textColor="@color/pes_red" />

                <Button
                    android:id="@+id/patches"
                    style="@style/MenuEntryRow"
                    android:text="@string/entry_patches" />

                <Button
                    android:id="@+id/settings"
                    style="@style/MenuEntryRow"
                    android:text="@string/entry_settings" />

                <Button
                    android:id="@+id/driver"
                    style="@style/MenuEntryRow"
                    android:text="@string/graphics_driver" />

                <Button
                    android:id="@+id/log"
                    style="@style/MenuEntryRow"
                    android:text="@string/view_log" />

                <Button
                    android:id="@+id/check_update"
                    style="@style/MenuEntryRow"
                    android:text="@string/check_for_updates" />

                <Button
                    android:id="@+id/entry_quit"
                    style="@style/MenuEntryRow"
                    android:text="@string/quit_launcher" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/direct_launch_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="2dp"
                    android:text="@string/direct_launch"
                    android:textColor="@color/pes_muted"
                    android:textSize="10sp"
                    android:fontFamily="sans-serif-medium" />

                <!-- The chosen entry's details: a PES 6 settings panel, title strip and body. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_panel"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/detail_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_panel_title"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="4dp"
                        android:text="@string/detail_default_title"
                        android:textColor="@color/pes_on_dark"
                        android:textSize="14sp"
                        android:textStyle="bold|italic"
                        android:textAllCaps="true"
                        android:fontFamily="sans-serif-condensed"
                        android:accessibilityLiveRegion="polite" />

                    <TextView
                        android:id="@+id/detail_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="8dp"
                        android:maxLines="6"
                        android:ellipsize="end"
                        android:text="@string/detail_default_text"
                        android:textColor="@color/pes_text"
                        android:textSize="11sp"
                        android:lineSpacingExtra="2dp"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:id="@+id/status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_setting_row"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="8dp"
                        android:maxLines="5"
                        android:ellipsize="end"
                        android:textColor="@color/pes_blue"
                        android:textSize="11sp"
                        android:lineSpacingExtra="2dp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Developer credits: Xclipse Edition first, original developer second. -->
        <LinearLayout
            android:id="@+id/credit_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:contentDescription="@string/about_source">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_github"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/credit_url"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:gravity="center_vertical"
                android:text="Xclipse Edition developer — github.com/netherfiles&#10;Original developer — github.com/sharifhidayatulloh"
                android:textColor="@color/pes_blue"
                android:textSize="9sp"
                android:lineSpacingExtra="3dp"
                android:fontFamily="sans-serif"
                android:importantForAccessibility="no"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="GPL-3.0"
                android:textColor="@color/pes_muted"
                android:textSize="8sp"
                android:fontFamily="sans-serif"
                android:importantForAccessibility="no"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- The help strip along the foot: device, driver and build, scrolling. -->
        <TextView
            android:id="@+id/footer"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:background="@drawable/bg_ticker"
            android:gravity="center_vertical"
            android:paddingTop="2dp"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:focusable="false"
            android:textColor="@color/pes_on_dark"
            android:textSize="12sp"
            android:fontFamily="sans-serif-condensed" />
    </LinearLayout>
</FrameLayout>
