<?xml version="1.0" encoding="utf-8"?>
<!-- PATCH IMPORT: pick a source, see what was found and what it costs at its
     peak, choose what to install, then watch it and read the result. Every
     step is in this one scroll; only the current one is visible. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pes_page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/view_back_bar" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_panel"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_panel_title"
                        android:paddingStart="10dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="4dp"
                        android:text="@string/patch_import_heading"
                        android:textColor="@color/pes_on_dark"
                        android:textSize="14sp"
                        android:textStyle="bold|italic"
                        android:textAllCaps="true"
                        android:fontFamily="sans-serif-condensed" />

                    <TextView
                        style="@style/SettingHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="6dp"
                        android:paddingBottom="8dp"
                        android:text="@string/patch_import_pick_hint" />
                </LinearLayout>

                <!-- 1. source -->
                <LinearLayout
                    android:id="@+id/step_pick"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SectionHeading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/patches_section_patch" />

                    <LinearLayout style="@style/SettingGroup">

                        <TextView
                            android:id="@+id/import_source"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_setting_row"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:text="@string/patch_import_source_none"
                            android:textColor="@color/pes_text"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif" />

                        <Button
                            android:id="@+id/pick_archive"
                            style="@style/ActionButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/patch_import_archive" />

                        <Button
                            android:id="@+id/pick_folder"
                            style="@style/ActionButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/patch_import_folder" />

                        <Button
                            android:id="@+id/pick_multipart"
                            style="@style/ActionButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/patch_import_multipart" />

                        <TextView
                            style="@style/SettingHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/patch_import_pick_hint" />

                        <Button
                            android:id="@+id/import_cancel_pick"
                            style="@style/QuietButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/patch_import_cancel" />
                    </LinearLayout>
                </LinearLayout>

                <!-- scanning -->
                <LinearLayout
                    android:id="@+id/step_scanning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        style="@style/SettingGroup"
                        android:layout_marginTop="16dp"
                        android:padding="14dp">

                        <ProgressBar
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:indeterminate="true" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/patch_import_scanning"
                            android:textColor="@color/pes_blue"
                            android:textSize="14sp"
                            android:textStyle="bold|italic"
                            android:textAllCaps="true"
                            android:fontFamily="sans-serif-condensed"
                            android:accessibilityLiveRegion="polite" />

                        <TextView
                            style="@style/SettingHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/patch_import_scanning_hint" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 2. scan summary and options -->
                <LinearLayout
                    android:id="@+id/step_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/SectionHeading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/patch_import_ready" />

                    <LinearLayout style="@style/SettingGroup">

                        <TextView
                            android:id="@+id/summary_source"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="8dp"
                            android:textColor="@color/pes_text"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-condensed" />

                        <TextView
                            android:id="@+id/summary_focus"
                            style="@style/SettingHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/install_patch"
                            style="@style/SettingSwitch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:minHeight="48dp"
                            android:checked="true" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/install_edit"
                            style="@style/SettingSwitch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:checked="true" />

                        <Button
                            android:id="@+id/advanced_toggle"
                            style="@style/QuietButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="start|center_vertical"
                            android:paddingStart="10dp"
                            android:text="@string/patch_import_advanced" />

                        <LinearLayout
                            android:id="@+id/advanced_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_setting_row"
                            android:orientation="vertical"
                            android:padding="4dp"
                            android:visibility="gone">

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/install_system"
                                style="@style/SettingSwitch"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp"
                                android:text="@string/patch_import_system_toggle" />

                            <TextView
                                style="@style/SettingHint"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/patch_import_system_hint" />

                            <TextView
                                android:id="@+id/system_warning"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingStart="10dp"
                                android:paddingTop="2dp"
                                android:paddingBottom="6dp"
                                android:text="@string/patch_import_system_warning"
                                android:textColor="@color/pes_red"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/summary_skipped"
                            style="@style/SettingHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/summary_warning"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:textColor="@color/pes_red"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_setting_row"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/patch_import_peak_title"
                            android:textColor="@color/pes_muted"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:textAllCaps="true"
                            android:fontFamily="sans-serif-condensed" />

                        <TextView
                            android:id="@+id/peak_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:accessibilityLiveRegion="polite"
                            android:textColor="@color/pes_navy"
                            android:textSize="22sp"
                            android:textStyle="bold|italic"
                            android:textAllCaps="true"
                            android:fontFamily="sans-serif-condensed" />

                        <TextView
                            android:id="@+id/peak_breakdown"
                            style="@style/SettingHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/low_space"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:paddingTop="6dp"
                        android:textColor="@color/pes_red"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/install_button"
                        style="@style/ActionButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/patch_import_install" />

                    <Button
                        android:id="@+id/summary_cancel"
                        style="@style/QuietButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/patch_import_cancel" />
                </LinearLayout>

                <!-- 3. install progress -->
                <LinearLayout
                    android:id="@+id/step_install"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        style="@style/SettingGroup"
                        android:layout_marginTop="16dp"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/patch_import_installing"
                            android:textColor="@color/pes_blue"
                            android:textSize="14sp"
                            android:textStyle="bold|italic"
                            android:textAllCaps="true"
                            android:fontFamily="sans-serif-condensed"
                            android:accessibilityLiveRegion="polite" />

                        <ProgressBar
                            android:id="@+id/install_progress"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:max="1000" />

                        <TextView
                            android:id="@+id/install_text"
                            style="@style/SettingHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:accessibilityLiveRegion="polite" />

                        <TextView
                            android:id="@+id/install_file"
                            style="@style/SettingHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="middle"
                            android:maxLines="2"
                            android:textColor="@color/pes_blue"
                            android:textSize="11sp"
                            android:accessibilityLiveRegion="polite" />

                        <Button
                            android:id="@+id/install_stop"
                            style="@style/DangerButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/patch_import_stop" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 4. result -->
                <LinearLayout
                    android:id="@+id/step_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        style="@style/SettingGroup"
                        android:layout_marginTop="16dp"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/result_badge"
                            style="@style/StatusPill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:accessibilityLiveRegion="polite" />

                        <TextView
                            android:id="@+id/result_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/pes_navy"
                            android:textSize="22sp"
                            android:textStyle="bold|italic"
                            android:textAllCaps="true"
                            android:fontFamily="sans-serif-condensed" />

                        <TextView
                            android:id="@+id/result_body"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/pes_text"
                            android:textSize="13sp"
                            android:lineSpacingExtra="2dp"
                            android:fontFamily="sans-serif" />

                        <TextView
                            android:id="@+id/result_detail"
                            style="@style/SettingHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingBottom="4dp" />

                        <Button
                            android:id="@+id/result_done"
                            style="@style/ActionButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/patch_import_result_done" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:background="@drawable/bg_ticker"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingTop="2dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="@string/patch_import_help_strip"
            android:textColor="@color/pes_on_dark"
            android:textSize="12sp"
            android:fontFamily="sans-serif-condensed" />
    </LinearLayout>
</FrameLayout>
