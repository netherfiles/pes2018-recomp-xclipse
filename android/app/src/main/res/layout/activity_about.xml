<?xml version="1.0" encoding="utf-8"?>
<!-- ABOUT: the name, the build, where the source lives, the licence it is
     under, and the line that this is a fan project, nothing official. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pes_page"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_title"
            android:textColor="@color/pes_navy"
            android:textSize="22sp"
            android:textStyle="bold|italic"
            android:textAllCaps="true"
            android:fontFamily="sans-serif-condensed" />

        <TextView
            android:id="@+id/about_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/pes_muted"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            tools:text="0.0.2-alpha · build 16 · EUROPE" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/about_project"
            android:textColor="@color/pes_navy"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            style="@style/SectionHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_source" />

        <TextView
            android:id="@+id/about_source_link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoLink="web"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="4dp"
            android:text="https://github.com/sharifhidayatulloh/pes2018-recomp"
            android:textColor="@color/pes_blue"
            android:textColorLink="@color/pes_blue"
            android:textSize="13sp"
            android:fontFamily="sans-serif"
            tools:ignore="HardcodedText" />

        <TextView
            style="@style/SectionHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/about_license" />

        <TextView
            android:id="@+id/about_license_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="4dp"
            android:paddingTop="6dp"
            android:textColor="@color/pes_text"
            android:textSize="11sp"
            android:lineSpacingExtra="2dp"
            android:fontFamily="monospace"
            tools:text="GNU GENERAL PUBLIC LICENSE\nVersion 3, 29 June 2007" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/about_not_affiliated"
            android:textColor="@color/pes_muted"
            android:textSize="11sp"
            android:lineSpacingExtra="2dp"
            android:fontFamily="sans-serif" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/about_credits"
            android:textColor="@color/pes_muted"
            android:textSize="11sp"
            android:lineSpacingExtra="2dp"
            android:fontFamily="sans-serif" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/about_third_party"
            android:textColor="@color/pes_muted"
            android:textSize="11sp"
            android:lineSpacingExtra="2dp"
            android:fontFamily="sans-serif" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingStart="10dp"
            android:paddingEnd="4dp"
            android:text="@string/about_octicons_license"
            android:textColor="@color/pes_muted"
            android:textSize="10sp"
            android:lineSpacingExtra="2dp"
            android:fontFamily="monospace" />
    </LinearLayout>
</ScrollView>
