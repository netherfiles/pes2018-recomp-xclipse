
<?xml version="1.0" encoding="utf-8"?>
<!-- Xclipse Dark Edition - Footer ticker -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#111C2E"
                android:endColor="#080D18" />
        </shape>
    </item>
    <item
        android:gravity="top"
        android:height="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#E32636" />
        </shape>
    </item>
</layer-list>

