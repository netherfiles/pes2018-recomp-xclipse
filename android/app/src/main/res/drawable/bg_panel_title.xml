
<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#101B30"
                android:endColor="#174A7A" />
        </shape>
    </item>

    <item
