<?xml version="1.0" encoding="utf-8"?>
<!-- A destructive action: red rule and red type, clearly apart from RESTORE. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33DC0014">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="#F2F4F8" />
                    <stroke android:width="1dp" android:color="#C9D1DE" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#FFF5F6" />
                    <stroke android:width="1dp" android:color="#DC0014" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
