<?xml version="1.0" encoding="utf-8"?>
<!-- Xclipse Dark Edition - Destructive action -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#55E32636">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="#202A38" />
                    <stroke
                        android:width="1dp"
                        android:color="#465268" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#30151D" />
                    <stroke
                        android:width="1dp"
                        android:color="#E32636" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
