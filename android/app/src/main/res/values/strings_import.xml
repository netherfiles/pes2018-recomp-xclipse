<?xml version="1.0" encoding="utf-8"?>
<!--
  Strings for the import screen that only exist because a run can outlive the
  screen: the terminal record, the interrupted result and the notification tap.
  Kept out of strings.xml so the terminal-state change owns its own file.
-->
<resources>

    <string name="patch_import_checking">CHECKING THE LAST INSTALL…</string>

    <string name="patch_import_result_interrupted">INSTALL INTERRUPTED</string>
    <string name="patch_import_result_interrupted_body">The install stopped before it finished. The patch that was already installed is kept as it was, and the staged copy is cleaned up the next time the app starts.</string>
    <string name="patch_import_interrupted_hint">Try the install again, or check the PATCHES screen before playing.</string>
    <string name="patch_import_badge_interrupted">INTERRUPTED</string>
    <string name="patch_import_result_retry">TRY AGAIN</string>

    <string name="patch_install_notification_progress">%1$s · %2$d%%\n%3$s</string>
    <string name="patch_install_notification_progress_no_file">%1$s · %2$d%%</string>
    <string name="patch_install_stopped_by_system">Android stopped the install service</string>
    <string name="patch_install_stopped_unexpectedly">The install service stopped early</string>
    <string name="patch_install_result_unconfirmed">The app could not confirm that the install finished. Check the PATCHES screen before playing.</string>

</resources>
