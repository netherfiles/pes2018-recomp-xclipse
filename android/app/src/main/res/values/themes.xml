<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- XCLIPSE DARK EDITION -->
    <style name="Theme.PES17" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/pes_page</item>
        <item name="android:colorBackground">@color/pes_page</item>
        <item name="colorPrimary">@color/pes_navy</item>
        <item name="colorPrimaryDark">@color/pes_navy</item>
        <item name="colorAccent">@color/pes_red</item>
        <item name="colorControlActivated">@color/pes_red</item>
        <item name="android:textColorPrimary">@color/pes_text</item>
        <item name="android:textColorSecondary">@color/pes_muted</item>
        <item name="buttonStyle">@style/PanelButton</item>
        <item name="android:buttonStyle">@style/PanelButton</item>
        <item name="alertDialogTheme">@style/Theme.PES17.Dialog</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@color/pes_page</item>
        <item name="android:navigationBarColor">@color/pes_page</item>
    </style>

    <!-- GAME THEME -->
    <style name="Theme.PES17.Game" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="colorPrimary">@color/pes_navy</item>
        <item name="colorPrimaryDark">@color/pes_page</item>
        <item name="colorAccent">@color/pes_gold</item>
        <item name="android:textColorPrimary">@color/pes_text</item>
        <item name="android:textColorSecondary">@color/pes_muted</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="alertDialogTheme">@style/Theme.PES17.Dialog</item>
    </style>

    <!-- DARK ALERT DIALOGS -->
    <style name="Theme.PES17.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorPrimary">@color/pes_navy</item>
        <item name="colorPrimaryDark">@color/pes_navy</item>
        <item name="colorAccent">@color/pes_red</item>
        <item name="colorControlActivated">@color/pes_red</item>
        <item name="android:windowBackground">@color/pes_panel</item>
        <item name="android:colorBackground">@color/pes_panel</item>
        <item name="android:textColorPrimary">@color/pes_text</item>
        <item name="android:textColorSecondary">@color/pes_muted</item>
        <item name="alertDialogStyle">@style/PES17.AlertDialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogButtonQuiet</item>
        <item name="buttonBarNeutralButtonStyle">@style/DialogButtonQuiet</item>
    </style>

    <style name="PES17.AlertDialog" parent="AlertDialog.AppCompat">
        <item name="buttonBarPositiveButtonStyle">@style/DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogButtonQuiet</item>
        <item name="buttonBarNeutralButtonStyle">@style/DialogButtonQuiet</item>
    </style>

    <!-- CONFIRMATION BUTTON -->
    <style name="DialogButton" parent="ActionButton">
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <!-- DIALOG TEXT -->
    <style name="DialogTitle">
        <item name="android:textColor">@color/pes_text</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <style name="DialogBody">
        <item name="android:textColor">@color/pes_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- QUIET DIALOG BUTTON -->
    <style name="DialogButtonQuiet" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/pes_blue</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold|italic</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- SECTION HEADING -->
    <style name="SectionHeading">
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:background">@drawable/bg_section_bar</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textColor">@color/pes_on_dark</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold|italic</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <!-- SETTING LABEL -->
    <style name="SettingLabel">
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:background">@drawable/bg_setting_row</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:textColor">@color/pes_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <style name="SettingHint">
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textColor">@color/pes_muted</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="SettingSwitch">
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:background">@drawable/bg_setting_row</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:textColor">@color/pes_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
    </style>

    <!-- MAIN MENU -->
    <style name="MenuEntry">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:drawableStart">@drawable/ic_menu_cursor_space</item>
        <item name="android:textColor">@color/pes_text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold|italic</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- PORTRAIT MENU -->
    <style name="MenuEntryRow" parent="MenuEntry">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">0</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- SETTINGS GROUP -->
    <style name="SettingGroup">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:background">@drawable/bg_setting_group</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">4dp</item>
    </style>

    <!-- TABS -->
    <style name="TabEntry">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">34dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/pes_on_dark</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold|italic</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- BACK BUTTON -->
    <style name="BackButton">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/pes_gold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold|italic</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- PANEL BUTTON -->
    <style name="PanelButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_action</item>
        <item name="android:textColor">@color/pes_on_dark</item>
        <item name="android:textStyle">bold|italic</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- ACTION BUTTON -->
    <style name="ActionButton" parent="PanelButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- DANGER BUTTON -->
    <style name="DangerButton" parent="ActionButton">
        <item name="android:background">@drawable/bg_button_danger</item>
        <item name="android:textColor">@color/pes_red</item>
    </style>

    <!-- QUIET BUTTON -->
    <style name="QuietButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:minHeight">48dp</item>
        <item name="android:textColor">@color/pes_blue</item>
        <item name="android:textStyle">bold|italic</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- STATUS PILL -->
    <style name="StatusPill">
        <item name="android:background">@drawable/bg_pill_badge</item>
        <item name="android:paddingStart">9dp</item>
        <item name="android:paddingEnd">9dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textColor">@color/pes_gold</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold|italic</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

</resources>
